--!nonstrict
-- The actual PinkDotLock bundle with native API/event doubles. Projection
-- coordinates are supplied by PinkMock; this is not engine or Da Hood testing.
return function(mock, api, reloadBundle)
	local tests, failures, checks = 0, 0, 0
	local sessions, targets = {}, {}
	local V = mock.env.Vector3
	local function check(condition, message)
		checks += 1
		assert(condition, message or ("assertion failed at line " .. tostring(debug.info(2, "l"))))
	end
	local function near(actual, expected, tolerance)
		check(type(actual) == "number" and actual == actual and math.abs(actual - expected) <= (tolerance or 1e-8),
			"expected " .. tostring(expected) .. ", got " .. tostring(actual))
	end
	local function vectorNear(actual, expected, tolerance)
		check(actual ~= nil and expected ~= nil)
		near(actual.X, expected.X, tolerance)
		near(actual.Y, expected.Y, tolerance)
		near(actual.Z, expected.Z, tolerance)
	end
	local function withPatch(object, key, value, body)
		local old = object[key]
		object[key] = value
		local ok, problem = pcall(body)
		object[key] = old
		assert(ok, problem)
	end
	local function session(config)
		mock:setTime(10)
		mock:setCameraDistance(20)
		mock.services.Players.LocalPlayer.CameraMode = mock.env.Enum.CameraMode.Classic
		mock:setPointer(640, 360)
		local created = api.init(config)
		table.insert(sessions, created)
		return created
	end
	local function target(name, position)
		local created = mock:addPlayer(name, position)
		table.insert(targets, created)
		return created
	end
	local function pressC(processed)
		mock.services.UserInputService.InputBegan:Fire(mock:input("Keyboard", 0, 0, "C"), processed == true)
	end
	local function test(name, body)
		tests += 1
		local ok, problem = pcall(body)
		if not ok then failures += 1; print("FAIL PINK GUI " .. name .. ": " .. tostring(problem)) end
		for _, current in ipairs(sessions) do current:destroy() end
		table.clear(sessions)
		for _, current in ipairs(targets) do
			mock:removePlayer(current)
			if current.Character then current.Character:Destroy() end
			current:Destroy()
		end
		table.clear(targets)
		local failureToast = mock.playerGui:FindFirstChild("PinkDotLock_LoadFailure")
		if failureToast then failureToast:Destroy() end
	end

	test("successful initialization creates only a passive dot and one welcome toast", function()
		local s = session()
		check(s.overlay == s.ui and not s.destroyed)
		check(s.overlay.gui.Name == "PinkDotLock")
		check(s.overlay.toast.Visible)
		check(s.overlay.title.Text == "SEDWARE")
		check(s.overlay.body.Text == "Successfully Loaded | Press C to Lock")
		check(not s.overlay.dot.Visible)
		near(s.overlay.dot.Size.X.Offset, 6)
		near(s.overlay.dot.Size.Y.Offset, 6)
		near(s.overlay.dot.BackgroundColor3.R, 1)
		near(s.overlay.dot.BackgroundColor3.G, 105 / 255)
		near(s.overlay.dot.BackgroundColor3.B, 180 / 255)
		for _, node in ipairs(s.overlay.gui:GetDescendants()) do
			check(not node:IsA("TextButton") and not node:IsA("TextBox"), "a configuration control was created")
			if node:IsA("GuiObject") then check(node.Active == false, "overlay intercepted input") end
		end
		mock:resetCounters()
		mock:advance(0.18)
		near(s.overlay.toast.GroupTransparency, 0)
		mock:advance(3.7)
		check(s.overlay.toast.Visible)
		mock:advance(0.13)
		check(not s.overlay.toast.Visible)
		near(mock.counters.candidateScans, 0)
		near(mock.counters.cameraWrites, 0)
		near(mock.counters.mouseWrites, 0)
	end)

	test("C acquires the nearest central target in first person and unlocks immediately", function()
		local central = target("Central", V.new(4, 0, -50))
		local cursor = target("Cursor", V.new(70, 0, -50))
		local s = session({LockMode = "FirstPerson"})
		mock:setPointer(710, 360)
		mock:resetCounters()
		pressC()
		check(s:GetLockedTarget() == central)
		check(s:GetLockedTarget() ~= cursor)
		check(s.overlay.title.Text == "Locked: Central")
		check(s.overlay.dot.Visible)
		near(mock.counters.candidateScans, 1)
		near(s.overlay.dot.Position.X.Offset, 644)
		near(s.overlay.dot.Position.Y.Offset, 360)
		check(s:GetPrediction() ~= nil and s:GetPredictedPosition() ~= nil)
		pressC()
		check(s:GetLockedTarget() == nil and s:GetPredictedPosition() == nil)
		check(not s.overlay.dot.Visible)
		check(s.overlay.title.Text == "Unlocked")
		near(mock.counters.candidateScans, 1)
		near(#s.targetConnections, 0)
	end)

	test("third person uses viewport mouse coordinates without a duplicate inset and retains the chosen player", function()
		local left = target("Left", V.new(-80, 0, -50))
		local right = target("Right", V.new(80, 0, -50))
		local s = session({LockMode = "ThirdPerson"})
		mock:setPointer(720, 360)
		mock:resetCounters()
		pressC()
		check(s:GetLockedTarget() == right)
		near(mock.counters.candidateScans, 1)
		mock:setPointer(560, 360)
		mock:advance(0.1)
		check(s:GetLockedTarget() == right and s:GetLockedTarget() ~= left)
		near(mock.counters.candidateScans, 1)
		local secondLock, message = s:LockTarget(left)
		check(not secondLock and message == "Already Locked")
		check(s:GetLockedTarget() == right)
		near(mock.counters.cameraWrites, 0)
		near(mock.counters.mouseWrites, 0)
	end)

	test("processed input and typing never acquire or unlock a target", function()
		target("TypingTarget", V.new(0, 0, -50))
		local s = session()
		mock:resetCounters()
		pressC(true)
		check(s:GetLockedTarget() == nil)
		near(mock.counters.candidateScans, 0)
		local box = mock.env.Instance.new("TextBox")
		box:CaptureFocus()
		pressC()
		check(s:GetLockedTarget() == nil)
		near(mock.counters.candidateScans, 0)
		box:ReleaseFocus()
		box:Destroy()
		pressC()
		check(s:GetLockedTarget() ~= nil)
		pressC(true)
		check(s:GetLockedTarget() ~= nil)
	end)

	test("automatic mode has stable evidence and changing cameras preserves an existing lock", function()
		local t = target("Persistent", V.new(0, 0, -50))
		local s = session({LockMode = "Auto"})
		check(s.mode == "ThirdPerson")
		pressC()
		check(s:GetLockedTarget() == t)
		mock:setCameraDistance(0.1)
		mock:advance(0.05)
		check(s.mode == "ThirdPerson", "near-camera evidence skipped its dwell interval")
		mock:advance(0.25)
		check(s.mode == "FirstPerson")
		check(s:GetLockedTarget() == t)
		mock:setCameraDistance(0.95)
		mock:advance(0.5)
		check(s.mode == "FirstPerson", "hysteresis band changed mode")
		mock:setCameraDistance(20)
		mock:advance(0.01)
		mock:advance(0.25)
		check(s.mode == "ThirdPerson" and s:GetLockedTarget() == t)
		mock:resetCounters()
		mock:advance(0.1)
		near(mock.counters.cameraWrites, 0)
		near(mock.counters.mouseWrites, 0)
	end)

	test("the dot follows actual observations while X/Y prediction remains separate", function()
		local t = target("Moving", V.new(0, 0, -50))
		local s = session({LockMode = "ThirdPerson", PredictionSmoothing = 0, MemoryTracking = false})
		pressC()
		mock:resetCounters()
		for index = 1, 10 do
			mock:move(t, V.new(index, index * 0.5, -50 - index * 0.2), index < 5 and "Running" or "Jumping")
			mock:advance(0.05)
		end
		local actual = t.Character:FindFirstChild("HumanoidRootPart").Position
		local prediction = s:GetPrediction()
		check(prediction ~= nil)
		check(prediction.position.X > actual.X)
		check(prediction.position.Y > actual.Y)
		check(prediction.position.Z < actual.Z)
		near(s.overlay.dot.Position.X.Offset, 640 + actual.X)
		near(s.overlay.dot.Position.Y.Offset, 360 - actual.Y)
		check(math.abs(s.overlay.dot.Position.X.Offset - (640 + prediction.position.X)) > 0.1)
		near(mock.counters.candidateScans, 0)
		near(mock.counters.cameraWrites, 0)
		near(mock.counters.mouseWrites, 0)
	end)

	test("persistence survives occlusion offscreen movement and FOV changes without rescanning", function()
		local selected = target("Selected", V.new(0, 0, -50))
		target("Alternate", V.new(5, 0, -50))
		local s = session({TargetPersistence = true, MaxDistance = 2000})
		pressC()
		check(s:GetLockedTarget() == selected)
		mock:resetCounters()
		mock:setOccluded(selected, true)
		mock:move(selected, V.new(1000, 0, -50))
		mock:advance(0.1)
		check(s:GetLockedTarget() == selected)
		check(not s.overlay.dot.Visible)
		mock:move(selected, V.new(20, 0, -50))
		mock:setOccluded(selected, false)
		mock:advance(0.1)
		check(s:GetLockedTarget() == selected and s.overlay.dot.Visible)
		near(mock.counters.candidateScans, 0)
	end)

	test("acquisition rejects occluded invalid distant and out-of-FOV targets", function()
		local blocked = target("Blocked", V.new(0, 0, -50))
		local far = target("Far", V.new(0, 0, -900))
		local outside = target("Outside", V.new(500, 0, -50))
		local dead = target("Dead", V.new(1, 0, -50))
		mock:kill(dead)
		mock:setOccluded(blocked, true)
		local s = session({MaxDistance = 300, ThirdPersonFOV = 100})
		check(s:IsValidTarget(blocked))
		check(not s:IsValidTarget(mock.services.Players.LocalPlayer))
		check(not s:IsValidTarget(dead) and not s:IsValidTarget(far))
		pressC()
		check(s:GetLockedTarget() == nil)
		check(not s:LockTarget(outside))
		check(not s:LockTarget(blocked))
		mock:setOccluded(blocked, false)
		check(s:LockTarget(blocked))
		check(s:GetLockedTarget() == blocked)
	end)

	for _, invalidation in ipairs({"death", "character-removal", "part-removal", "player-removal", "respawn"}) do
		test("target " .. invalidation .. " unlocks immediately and never selects a replacement", function()
			local selected = target("Lost", V.new(0, 0, -50))
			target("Replacement", V.new(5, 0, -50))
			local s = session()
			pressC()
			check(s:GetLockedTarget() == selected)
			mock:resetCounters()
			if invalidation == "death" then mock:kill(selected)
			elseif invalidation == "character-removal" then selected.Character.Parent = nil
			elseif invalidation == "part-removal" then selected.Character:FindFirstChild("HumanoidRootPart"):Destroy()
			elseif invalidation == "player-removal" then mock:removePlayer(selected)
			else mock:respawn(selected, V.new(0, 0, -50)) end
			check(s:GetLockedTarget() == nil)
			check(not s.overlay.dot.Visible)
			check(s.overlay.title.Text == "Target Lost")
			near(#s.targetConnections, 0)
			mock:advance(0.1)
			check(s:GetLockedTarget() == nil)
			near(mock.counters.candidateScans, 0)
		end)
	end

	test("render rates do not cause player scans or unbounded prediction observations", function()
		for _, fps in ipairs({30, 60, 144}) do
			local selected = target("FPS" .. fps, V.new(0, 0, -50))
			local s = session({UpdateHz = 30})
			mock:resetCounters()
			for _ = 1, fps do mock:advance(1 / fps) end
			near(mock.counters.candidateScans, 0)
			pressC()
			check(s:GetLockedTarget() == selected)
			near(mock.counters.candidateScans, 1)
			local observations = 0
			local observe = s.prediction.observe
			s.prediction.observe = function(self, ...)
				observations += 1
				return observe(self, ...)
			end
			for index = 1, fps do
				mock:move(selected, V.new(index * 10 / fps, 0, -50))
				mock:advance(1 / fps)
			end
			check(observations >= 20 and observations <= 31)
			near(mock.counters.candidateScans, 1)
			near(mock.counters.cameraWrites, 0)
			s:destroy()
			mock:removePlayer(selected)
		end
	end)

	test("dot and notification configuration affects actual overlays without adding menus", function()
		target("NoDot", V.new(0, 0, -50))
		local s = session({ShowDot = false, WelcomeNotification = false, ShowNotifications = false,
			DotSize = 9, DotTransparency = 0.4, DotOutline = false})
		check(not s.overlay.toast.Visible)
		pressC()
		check(s:GetLockedTarget() ~= nil)
		check(not s.overlay.dot.Visible and not s.overlay.toast.Visible)
		near(s.overlay.dot.Size.X.Offset, 9)
		near(s.overlay.dot.BackgroundTransparency, 0.4)
		check(s.overlay.dot:FindFirstChildOfClass("UIStroke") == nil)
		s:UnlockTarget()
		check(not s.overlay.toast.Visible)
	end)

	test("owned shooting adapters consume actual prediction snapshots and clean up with their session", function()
		local selected = target("OwnedShot", V.new(0, 0, -50))
		local s = session({PredictionSmoothing = 0})
		pressC()
		for index = 1, 5 do mock:move(selected, V.new(index, 0, -50)); mock:advance(0.05) end
		local fired
		local adapter = s:CreateShotAdapter(function(ticket) fired = ticket end)
		local ticket, problem = adapter:fire()
		check(ticket ~= nil, problem)
		check(fired == ticket and ticket.targetUserId == selected.UserId)
		local referenceTime = mock.world:GetServerTimeNow()
		local actual = selected.Character:FindFirstChild("HumanoidRootPart").Position
		local measurement, rejected = adapter:record(ticket, {accepted = true, targetUserId = selected.UserId,
			character = selected.Character, actualPosition = actual, referenceTime = referenceTime})
		check(measurement ~= nil, rejected)
		check(measurement.active.errorStuds > 0)
		near(s.lastError, measurement.active.errorStuds)
		near(adapter:summary().measurementCount, 1)
		check(adapter:record(ticket, {accepted = true, targetUserId = selected.UserId, actualPosition = actual,
			referenceTime = referenceTime}) == nil)
		s:destroy()
		check(adapter.destroyed)
		check(adapter:fire() == nil)
		near(mock:countConnections(), 0)
	end)

	test("duplicate execution and disabling leave a single owner then remove every listener", function()
		target("OwnerTarget", V.new(0, 0, -50))
		local first = session()
		pressC()
		local second = session()
		check(first.destroyed and first.overlay.destroyed)
		near(#first.targetConnections, 0)
		near(#first.connections, 0)
		local overlays, owners = 0, 0
		for _, child in ipairs(mock.playerGui:GetChildren()) do
			if child.Name == "PinkDotLock" then overlays += 1 end
			if child.Name == "PinkDotLock_Owner_v1" then owners += 1 end
		end
		near(overlays, 1)
		near(owners, 1)
		check(second:SetEnabled(false))
		check(second.destroyed and second:GetLockedTarget() == nil)
		near(mock:countConnections(), 0)
		pressC()
		mock:advance(0.1)
		check(second:GetPredictedPosition() == nil)
		local disabled = session({Enabled = false})
		check(disabled.destroyed and disabled.overlay == nil)
		near(mock:countConnections(), 0)
	end)

	test("failed initialization shows no success and preserves an existing working session", function()
		local first = session()
		local oldGui = first.overlay.gui
		local listeners = mock:countConnections()
		local originalNew = mock.env.Instance.new
		withPatch(mock.env.Instance, "new", function(className)
			if className == "CanvasGroup" then error("controlled pink construction failure") end
			return originalNew(className)
		end, function()
			local failed, report = api.tryInit()
			check(failed == nil and report.ready == false)
			check(not first.destroyed and oldGui.Parent == mock.playerGui)
			near(mock:countConnections(), listeners)
			local overlays = 0
			for _, child in ipairs(mock.playerGui:GetChildren()) do if child.Name == "PinkDotLock" then overlays += 1 end end
			near(overlays, 1)
		end)
		first:destroy()
		withPatch(mock.camera, "ViewportSize", nil, function()
			local oldFlag=mock.env.PINK_DOT_NO_AUTOSTART
			mock.env.PINK_DOT_NO_AUTOSTART=false
			local failed=reloadBundle(mock.env)
			mock.env.PINK_DOT_NO_AUTOSTART=oldFlag
			check(failed.session == nil and failed.compatibility.ready == false)
			local toast = mock.playerGui:FindFirstChild("PinkDotLock_LoadFailure")
			check(toast~=nil)
			check(toast:FindFirstChild("Title", true).Text == "SEDWARE | Load Failed")
			for _, node in ipairs(toast:GetDescendants()) do check(node.Text ~= "Successfully Loaded | Press C to Lock") end
			near(mock:countConnections(), 0)
		end)
		mock:advance(2.1)
		check(mock.playerGui:FindFirstChild("PinkDotLock_LoadFailure") == nil)
	end)

	test("destroying the GUI and LocalScript removes all listeners and locks",function()
		target("Lifecycle",V.new(0,0,-50))
		local s=session()
		pressC()
		s.overlay.gui:Destroy()
		check(s.destroyed and s:GetLockedTarget()==nil)
		near(mock:countConnections(),0)
		local localScript=mock.env.Instance.new("LocalScript")
		withPatch(mock.env,"script",localScript,function()
			local separate=reloadBundle(mock.env)
			local owned=separate.init()
			table.insert(sessions,owned)
			check(not owned.destroyed)
			localScript:Destroy()
			check(owned.destroyed)
			near(mock:countConnections(),0)
		end)
	end)

	test("a critical render failure unloads and displays a single temporary failure toast",function()
		target("FrameFailure",V.new(0,0,-50))
		local s=session()
		pressC()
		withPatch(mock.camera,"ViewportSize",nil,function()
			mock:advance(0.05)
			check(s.destroyed)
			near(mock:countConnections(),0)
			local failure=mock.playerGui:FindFirstChild("PinkDotLock_LoadFailure")
			check(failure~=nil)
			check(failure:FindFirstChild("Title",true).Text=="SEDWARE | Load Failed")
		end)
		mock:advance(2.1)
		check(mock.playerGui:FindFirstChild("PinkDotLock_LoadFailure")==nil)
	end)

	test("the configured key and native ping source drive actual auto prediction",function()
		local selected=target("AutoKey",V.new(0,0,-50))
		withPatch(mock.services.Players.LocalPlayer,"GetNetworkPing",function() return 0.062 end,function()
			local s=session({LockKey="V",LockMode="FirstPerson",AutoPrediction=true,PredictionSmoothing=0})
			check(s.overlay.body.Text=="Successfully Loaded | Press V to Lock")
			pressC()
			check(s:GetLockedTarget()==nil)
			mock.services.UserInputService.InputBegan:Fire(mock:input("Keyboard",0,0,"V"),false)
			check(s:GetLockedTarget()==selected)
			local p=s:GetPrediction()
			check(p.status=="Auto")
			near(p.baseX,0.120)
			near(p.baseY,0.080)
			near(p.rawPingMs,62)
			mock.services.UserInputService.InputBegan:Fire(mock:input("Keyboard",0,0,"V"),false)
			check(s:GetLockedTarget()==nil)
		end)
	end)

	print(string.format("Pink native doubles: %d tests, %d assertions, %d failures", tests, checks, failures))
	assert(failures == 0, "Pink GUI/runtime tests failed")
	return {tests = tests, checks = checks}
end
