 local oldHorizontal=math.sqrt(oldVelocity.X*oldVelocity.X+oldVelocity.Z*oldVelocity.Z)
 local newHorizontal=math.sqrt(instantaneous.X*instantaneous.X+instantaneous.Z*instantaneous.Z)
