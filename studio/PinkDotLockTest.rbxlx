factories["Bootstrap"] = function(loadModule)
--!nonstrict
-- Protected startup orchestration. Runtime owns readiness; Session owns resources.
local Runtime = loadModule("Runtime")
local Bootstrap = {}

function Bootstrap.new(initialConfig,getModule,moduleNames,headerError)
 local API={Config=initialConfig,getModule=getModule}
 API.Modules=setmetatable({}, {__index=function(_,name) return getModule(name) end})
 local generation=0
 function API.checkCompatibility(options)
  return Runtime.check(options or initialConfig)
 end
 function API.tryInit(options)
  generation+=1
  local request=generation
  local report={ready=false,missing={},pending={},warnings={},events={}}
  API.compatibility=report
  local phase="Modules"
  Runtime.trace(report,"Execution","START","SEDWARE startup v3; robust LockKey normalization")
  local normalized
  local ok,result=xpcall(function()
   for _,name in moduleNames do getModule(name) end
   Runtime.trace(report,"Modules","READY",tostring(#moduleNames).." embedded modules loaded")
   phase="Configuration"
   if options==nil and headerError then error(headerError,0) end
   local problem
   normalized,problem=getModule("Config").new(if options~=nil then options else initialConfig)
   assert(normalized,problem)
   Runtime.trace(report,"Configuration","READY","PredictionX="..normalized.PredictionX.." PredictionY="..normalized.PredictionY
    .." Enabled="..tostring(normalized.Enabled).." WelcomeNotification="..tostring(normalized.WelcomeNotification)
    .." ShowNotifications="..tostring(normalized.ShowNotifications))
   phase="Services"
   local audit=Runtime.check(normalized)
   audit.events=report.events
   report=Runtime.awaitReady(normalized,audit,function() return request~=generation end)
   if request~=generation or report.cancelled then return nil end
   API.compatibility=report
   if not report.ready then error(Runtime.errorMessage(report),0) end
   for _,warning in report.warnings do Runtime.trace(report,"Compatibility","WARN",warning) end
   phase="Session"
   local session=getModule("Session").init(normalized,report)
   API.session=session
   return session
  end,Runtime.traceback)
  if request~=generation or report.cancelled then
   report.ready=false;report.cancelled=true
   Runtime.trace(report,"Session","CANCELLED","A newer initialization replaced this request")
   return nil,report
  end
  API.compatibility=report
  if ok then return result,report end
  -- Configuration/module errors can occur before the audit. Find PlayerGui
  -- without waiting on an invalid configuration so an error toast can be shown.
  if not report.playerGui then
   local audited,audit=pcall(Runtime.check,normalized)
   if audited then
    report.services=report.services or audit.services
    report.playerGui=audit.playerGui;report.player=audit.player;report.world=audit.world
   end
  end
  phase=report.failurePhase or phase
  report.ready=false;report.error=tostring(result)
  table.insert(report.missing,phase..": "..tostring(result))
  Runtime.trace(report,phase,"FAIL",result)
  local notified,notifyError=pcall(function() getModule("Session").notifyFailure(report,phase..": "..tostring(result)) end)
  if not notified then
   Runtime.reportFailure(phase..": "..tostring(result))
   Runtime.trace(report,"FailureNotification","FAIL",notifyError)
   -- Overlay has no Config/Session dependency; module failures can still show
   -- an error when this small independent public-API display remains usable.
   local shown,fallbackError=pcall(function() return getModule("Overlay").showFailure(report.playerGui,phase..": "..tostring(result)) end)
   if not shown then Runtime.trace(report,"FailureNotification","FAIL",fallbackError) end
  end
  return nil,report
 end
 function API.init(options)
  local session,report=API.tryInit(options)
  if not session then error(Runtime.errorMessage(report),2) end
  return session
 end
 for _,name in {"GetLockedTarget","GetPredictedPosition","GetPrediction","LockTarget","UnlockTarget","IsValidTarget","CreateShotAdapter","SetWeaponProfile","SetPredictionOrigin","SetEnabled","Unload"} do
  API[name]=function(...)
   if not API.session then return nil,"Not initialized" end
   return API.session[name](API.session,...)
  end
 end
 return API
end
return Bootstrap
end
-- END Bootstrap
local built,API=xpcall(function()
 return loadModule("Bootstrap").new(Config,loadModule,{"Settings", "Latency", "MotionHistory", "Ballistics", "Config", "ModeDetector", "Selection", "Prediction", "Overlay", "Runtime", "ShotAdapter", "Session", "Bootstrap"},headerError)
end,bootTraceback)
if not built then
 bootLog("Modules","FAIL",API)
 local problem=tostring(API)
 local shown,issue=pcall(function()
  local players=game:GetService("Players")
  local player=players.LocalPlayer
  return loadModule("Overlay").showFailure(player and player:FindFirstChild("PlayerGui"),"Modules: "..problem)
 end)
 if not shown then bootLog("FailureNotification","FAIL",issue) end
 return {compatibility={ready=false,missing={tostring(API)}},error=tostring(API)}
end
if not PINK_DOT_NO_AUTOSTART then
 local started,problem=xpcall(function() return API.tryInit() end,bootTraceback)
 if not started then
  bootLog("AutoInit","FAIL",problem)
  local notified,issue=pcall(function() loadModule("Session").notifyFailure(API.compatibility,problem) end)
  if not notified then bootLog("FailureNotification","FAIL",issue) end
 end
else bootLog("AutoInit","SKIPPED","PINK_DOT_NO_AUTOSTART=true; call API.init() to start") end
return API
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Folder" referent="RBX9">
      <Properties>
        <string name="Name">SEDWAREWeaponModules</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX10">
        <Properties>
          <string name="Name">WeaponSettings</string>
          <ProtectedString name="Source">--!nonstrict
-- Settings for the OWNED Studio weapon. These are not Da Hood weapon facts.
local WeaponSettings = {}
local defaults = {
	WeaponName = "SEDWARE Revolver", Range = 400, Cooldown = 0.35, Damage = 25,
	RequestMaxAge = 0.6, ClockTolerance = 0.05, MaxOriginDistance = 3,
	MaxAimDistance = 2000, MaxSessionsPerPlayer = 64,
	MaxProjectiles = 64, MaxProjectilesPerPlayer = 8,
}
local allowedParts = {}
for _, name in {
	"HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso",
	"Left Arm", "Right Arm", "Left Leg", "Right Leg", "LeftHand", "RightHand",
	"LeftFoot", "RightFoot", "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm",
	"LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg",
} do allowedParts[name] = true end

local limits = {
	Range = { 1, 2000 }, Cooldown = { 0.05, 10 }, Damage = { 0, 100 },
	RequestMaxAge = { 0.05, 2 }, ClockTolerance = { 0, 0.2 }, MaxOriginDistance = { 0, 5 },
	MaxAimDistance = { 1, 10000 }, MaxSessionsPerPlayer = { 1, 128 },
	MaxProjectiles = { 1, 256 }, MaxProjectilesPerPlayer = { 1, 32 },
}
function WeaponSettings.new(overrides)
	local config = table.clone(defaults)
	if overrides ~= nil then
		assert(type(overrides) == "table" and getmetatable(overrides) == nil, "Weapon settings must be a plain table")
		for key, value in overrides do
			assert(defaults[key] ~= nil, "Unknown weapon setting: " .. tostring(key))
			config[key] = value
		end
	end
	assert(type(config.WeaponName) == "string" and #config.WeaponName &gt; 0 and #config.WeaponName &lt;= 64, "Invalid WeaponName")
	for key, bounds in limits do
		local value = config[key]
		assert(type(value) == "number" and value == value and value &gt;= bounds[1] and value &lt;= bounds[2], "Invalid " .. key)
	end
	assert(config.MaxSessionsPerPlayer % 1 == 0, "MaxSessionsPerPlayer must be an integer")
	assert(config.MaxProjectiles%1==0 and config.MaxProjectilesPerPlayer%1==0,"Projectile capacities must be integers")
	config.AllowedParts = table.freeze(table.clone(allowedParts))
	return table.freeze(config)
end
return WeaponSettings
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX11">
        <Properties>
          <string name="Name">WeaponProfiles</string>
          <ProtectedString name="Source">--!nonstrict
-- Configurable OWNED weapon definitions. None describe weapons in Da Hood.
local WeaponProfiles = {}
local base = {
 Name="SEDWARE Custom", Family="Custom", Kind="Hitscan", Automatic=false,
 Range=400, Cooldown=0.35, Damage=25, Pellets=1, SpreadDegrees=0,
 Speed=0, Gravity=0, Lifetime=3,
 PredictionXOffset=0, PredictionYOffset=0, LatencyOffsetSeconds=0,
 CloseOffset=0, MediumOffset=0, LongOffset=0,
}
local limits = {
 Range={1,2000}, Cooldown={0.05,10}, Damage={0,100}, Pellets={1,32}, SpreadDegrees={0,20},
 Speed={0,3000}, Gravity={0,500}, Lifetime={0.1,5},
 PredictionXOffset={-0.2,0.2}, PredictionYOffset={-0.2,0.2}, LatencyOffsetSeconds={-0.2,0.2},
 CloseOffset={-0.2,0.2}, MediumOffset={-0.2,0.2}, LongOffset={-0.2,0.2},
}
local examples = {
 Revolver={Name="SEDWARE Revolver",Family="Revolver",Cooldown=0.35,Damage=25},
 Pistol={Name="SEDWARE Pistol",Family="Pistol",Cooldown=0.2,Damage=15,Range=300},
 Shotgun={Name="SEDWARE Shotgun",Family="Shotgun",Cooldown=0.8,Damage=6,Range=180,Pellets=8,SpreadDegrees=3},
 Rifle={Name="SEDWARE Rifle",Family="Rifle",Cooldown=0.3,Damage=30,Range=600,SpreadDegrees=0.15},
 Automatic={Name="SEDWARE Automatic",Family="Automatic",Automatic=true,Cooldown=0.12,Damage=8,Range=400,SpreadDegrees=1},
 Projectile={Name="SEDWARE Projectile",Family="Projectile",Kind="Projectile",Cooldown=0.7,Damage=35,
  Range=250,Speed=160,Gravity=196.2,Lifetime=3},
}
function WeaponProfiles.validId(value)
 return type(value)=="string" and #value&gt;=1 and #value&lt;=40 and string.match(value,"^[A-Za-z][A-Za-z0-9_]*$")~=nil
end
function WeaponProfiles.normalize(id,overrides)
 assert(WeaponProfiles.validId(id),"Invalid owned weapon ID")
 assert(type(overrides)=="table" and getmetatable(overrides)==nil,"Weapon profile must be a plain table")
 local result=table.clone(base)
 for key,value in overrides do
  assert(base[key]~=nil or key=="Id","Unknown weapon profile field: "..tostring(key))
  if key=="Id" then assert(value==id,"Profile ID mismatch") else result[key]=value end
 end
 for _,key in {"Name","Family"} do assert(type(result[key])=="string" and #result[key]&gt;0 and #result[key]&lt;=64,"Invalid profile "..key) end
 assert(result.Kind=="Hitscan" or result.Kind=="Projectile","Invalid weapon kind")
 assert(type(result.Automatic)=="boolean","Invalid Automatic flag")
 for key,bounds in limits do
  local value=result[key]
  assert(type(value)=="number" and value==value and value&gt;=bounds[1] and value&lt;=bounds[2],"Invalid profile "..key)
 end
 assert(result.Pellets%1==0,"Pellets must be an integer")
 if result.Kind=="Projectile" then
  assert(result.Speed&gt;0,"Physical projectile requires positive Speed")
  assert(result.Pellets==1,"This physical projectile controller accepts one projectile per shot")
 else
  assert(result.Speed==0 and result.Gravity==0,"Hitscan must not claim projectile speed or gravity")
 end
 result.Id=id
 return table.freeze(result)
end
function WeaponProfiles.defaults()
 local result={}
 for id,profile in examples do result[id]=WeaponProfiles.normalize(id,profile) end
 return result
end
function WeaponProfiles.prediction(profile)
 return {Kind=profile.Kind,Speed=profile.Speed,Gravity=profile.Gravity,
  PredictionXOffset=profile.PredictionXOffset,PredictionYOffset=profile.PredictionYOffset,
  LatencyOffsetSeconds=profile.LatencyOffsetSeconds,CloseOffset=profile.CloseOffset,
  MediumOffset=profile.MediumOffset,LongOffset=profile.LongOffset}
end
return WeaponProfiles
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">ClientController</string>
          <ProtectedString name="Source">--!nonstrict
-- OWNED weapon routing only. The client requests an aim point; only an independent
-- server raycast can confirm contact. This module does not touch camera or remotes.
local ClientController = {}
ClientController.__index = ClientController

local function finite(value)
 return type(value)=="number" and value==value and math.abs(value)&lt;math.huge
end
local function vector(value)
 if typeof(value)~="Vector3" and type(value)~="table" then return false end
 local ok,x,y,z=pcall(function() return value.X,value.Y,value.Z end)
 return ok and finite(x) and finite(y) and finite(z)
end
local function integer(value) return finite(value) and value%1==0 end
local function samePosition(a,b)
 return vector(a) and vector(b) and a.X==b.X and a.Y==b.Y and a.Z==b.Z
end
local function traceback(problem)
 return if debug and type(debug.traceback)=="function" then debug.traceback(tostring(problem),2) else tostring(problem)
end
local function invoke(callback,...)
 return xpcall(callback,traceback,...)
end

function ClientController.new(options)
 assert(type(options)=="table","Owned weapon options required")
 local api=options.api
 assert(type(api)=="table" and type(api.GetLockedTarget)=="function" and type(api.GetPredictedPosition)=="function",
  "SEDWARE target/prediction API required")
 for _,name in {"clock","send","getCameraAim","getOrigin","isEquipped"} do
  assert(type(options[name])=="function",name.." callback required")
 end
 assert(type(options.sessionId)=="string" and #options.sessionId&gt;=1 and #options.sessionId&lt;=64,"Invalid owned weapon sessionId")
 assert(options.onStatus==nil or type(options.onStatus)=="function","Invalid onStatus callback")
 assert(options.getWeapon==nil or type(options.getWeapon)=="function","Invalid weapon provider")
 local timeout,maxPending=options.timeout or 2,options.maxPending or 64
 assert(finite(timeout) and timeout&gt;0 and timeout&lt;=10,"Invalid response timeout")
 assert(integer(maxPending) and maxPending&gt;=1 and maxPending&lt;=500,"Invalid pending capacity")
 local adapter=options.adapter
 if not adapter then
  assert(type(api.CreateShotAdapter)=="function","SEDWARE owned shot adapter API required")
  local ok,result,problem=invoke(api.CreateShotAdapter,nil,{getOrigin=options.getOrigin,maxAge=options.maxAge or 1})
  assert(ok and result,"Cannot create owned shot adapter: "..tostring(if ok then problem else result))
  adapter=result
 end
 assert(type(adapter)=="table" and type(adapter.capture)=="function" and type(adapter.record)=="function"
  and type(adapter.destroy)=="function","Invalid owned shot adapter")
 return setmetatable({api=api,adapter=adapter,clock=options.clock,send=options.send,getCameraAim=options.getCameraAim,
  getOrigin=options.getOrigin,isEquipped=options.isEquipped,onStatus=options.onStatus,sessionId=options.sessionId,
  weaponName=options.weaponName or "SEDWARE Revolver",getWeapon=options.getWeapon,timeout=timeout,maxPending=maxPending,pending={},pendingCount=0,
  nextId=0,destroyed=false,lastResult=nil,stats={sent=0,confirmed=0,hits=0,selectedTargetHits=0,misses=0,
   rejected=0,timedOut=0,measurementCount=0}},ClientController)
end

function ClientController:_status(kind,details)
 if self.onStatus then pcall(self.onStatus,kind,details) end
end
function ClientController:_reject(reason)
 self:_status("ClientRejected",{reason=tostring(reason)})
 return nil,tostring(reason)
end

function ClientController:fire()
 if self.destroyed then return nil,"destroyed" end
 local equipped,isEquipped=invoke(self.isEquipped)
 if not equipped or isEquipped~=true then return self:_reject(if equipped then "weapon-not-equipped" else "equipment-check-failed: "..tostring(isEquipped)) end
 local clockOK,now=invoke(self.clock)
 if not clockOK or not finite(now) then return self:_reject("invalid-clock") end
 self:step(now)
 if self.pendingCount&gt;=self.maxPending then return self:_reject("pending-capacity") end
 local weapon
 if self.getWeapon then
  local weaponOK,result=invoke(self.getWeapon)
  if not weaponOK or type(result)~="table" or type(result.id)~="string" or #result.id&lt;1 or #result.id&gt;40
   or not finite(result.timeout) or result.timeout&lt;=0 or result.timeout&gt;10 then return self:_reject("invalid-compatible-weapon") end
  weapon=result
 end
 local originOK,origin=invoke(self.getOrigin)
 if not originOK or not vector(origin) then return self:_reject("muzzle-origin-unavailable") end
 local lockedOK,target=invoke(self.api.GetLockedTarget)
 if not lockedOK then return self:_reject("target-api-failed: "..tostring(target)) end
 local ticket,aimpoint,mode
 if target then
  mode="Locked"
  local captured,result,problem=invoke(function() return self.adapter:capture() end)
  if not captured or not result then return self:_reject("prediction-capture-failed: "..tostring(if captured then problem else result)) end
  ticket=result
  local predicted,resultPosition=invoke(self.api.GetPredictedPosition,origin)
  if not predicted or not vector(resultPosition) then return self:_reject("locked-prediction-unavailable") end
  aimpoint=resultPosition -- Exact public API position, never camera direction while locked.
  local currentOK,current=invoke(self.api.GetLockedTarget)
  if not currentOK or current~=target or target.UserId~=ticket.targetUserId then return self:_reject("target-changed-during-capture") end
  if not samePosition(aimpoint,ticket.aimpointActive) then return self:_reject("prediction-changed-during-capture") end
  if not integer(ticket.id) or not finite(ticket.sampleTime) or not finite(ticket.capturedAt) then return self:_reject("invalid-capture-ticket") end
 else
  mode="Normal"
  local aimed,result=invoke(self.getCameraAim)
  if not aimed or not vector(result) then return self:_reject("camera-aim-unavailable") end
  aimpoint=result
 end
 local dx,dy,dz=aimpoint.X-origin.X,aimpoint.Y-origin.Y,aimpoint.Z-origin.Z
 local length=math.sqrt(dx*dx+dy*dy+dz*dz)
 if not finite(length) or length&lt;=0.001 then return self:_reject("degenerate-aimpoint") end
 self.nextId+=1
 local request={sessionId=self.sessionId,shotId=self.nextId,mode=mode,capturedAt=now,origin=origin,aimpoint=aimpoint}
 if weapon then request.weaponId=weapon.id end
 if ticket then
  local partName=if self.api.session and self.api.session.config then self.api.session.config.TargetPart else ticket.part and ticket.part.Name
  if type(partName)~="string" or #partName&lt;1 or #partName&gt;64 then return self:_reject("invalid-target-part") end
  request.ticketId=ticket.id;request.targetUserId=ticket.targetUserId
  request.targetCharacter=ticket.character;request.partName=partName;request.sampleTime=ticket.sampleTime
 end
 table.freeze(request)
 -- Register before send, so synchronous owned transports can return a result.
 local entry={request=request,ticket=ticket,sentAt=now,timeout=if weapon then weapon.timeout else self.timeout,launched=false}
 self.pending[request.shotId]=entry;self.pendingCount+=1
 self:_status("Pending",{request=request,shotId=request.shotId,mode=mode})
 local sent,result=invoke(self.send,request)
 if not sent or result==false then
  if self.pending[request.shotId] then self.pending[request.shotId]=nil;self.pendingCount-=1 end
  return self:_reject("send-failed: "..tostring(result))
 end
 self.stats.sent+=1
 return request
end

function ClientController:receive(response)
 if self.destroyed then return nil,"destroyed" end
 if type(response)~="table" or response.sessionId~=self.sessionId or not integer(response.shotId) then return nil,"foreign-or-invalid-response" end
 local clockOK,now=invoke(self.clock)
 if not clockOK or not finite(now) then return nil,"invalid-clock" end
 self:step(now)
 local entry=self.pending[response.shotId]
 if not entry then return nil,"unknown-or-expired-shot" end
 local request=entry.request
 if type(response.accepted)~="boolean" or (response.mode~=nil and response.mode~=request.mode) then return nil,"malformed-response" end
 if response.ticketId~=nil and response.ticketId~=request.ticketId then return nil,"ticket-mismatch" end
 if response.weaponId~=request.weaponId then return nil,"weapon-mismatch" end
 if response.pending==true then
  if response.accepted~=true or response.mode~=request.mode or response.stage~="Launched" or response.hit~=nil
   or response.selectedTargetHit~=nil or response.damageApplied~=nil or entry.launched then return nil,"invalid-launch-confirmation" end
  entry.launched=true
  self:_status("InFlight",{shotId=request.shotId,mode=request.mode,weaponId=request.weaponId})
  return {pending=true,shotId=request.shotId,weaponId=request.weaponId}
 end
 if response.accepted then
  if response.mode~=request.mode or type(response.hit)~="boolean" or type(response.selectedTargetHit)~="boolean"
   or (response.selectedTargetHit and (not response.hit or request.mode~="Locked"))
   or (response.damageApplied~=nil and (not finite(response.damageApplied) or response.damageApplied&lt;0))
   or not finite(response.referenceTime) or response.referenceTime&lt;entry.sentAt-0.05 or response.referenceTime&gt;now+0.25 then
   return nil,"malformed-confirmation"
  end
  if response.impactPosition~=nil and not vector(response.impactPosition) then return nil,"invalid-impact-position" end
  if request.mode=="Locked" then
   if response.targetUserId~=request.targetUserId or response.character~=request.targetCharacter then return nil,"target-mismatch" end
   if response.actualPosition~=nil and not vector(response.actualPosition) then return nil,"invalid-reference-position" end
  end
 end
 self.pending[response.shotId]=nil;self.pendingCount-=1
 local result={sessionId=self.sessionId,shotId=request.shotId,mode=request.mode,accepted=response.accepted,
  reason=response.reason,referenceTime=response.referenceTime,impactPosition=response.impactPosition,
  hit=response.accepted and response.hit==true,selectedTargetHit=response.accepted and response.selectedTargetHit==true,
  damageApplied=response.damageApplied,hitName=response.hitName,request=request,weaponId=request.weaponId,
  pelletCount=response.pelletCount,pelletHits=response.pelletHits,pellets=response.pellets,
  engine=response.engine,physicsKind=response.physicsKind}
 if response.accepted then
  self.stats.confirmed+=1
  if result.hit then self.stats.hits+=1 else self.stats.misses+=1 end
  if result.selectedTargetHit then self.stats.selectedTargetHits+=1 end
  if entry.ticket and response.actualPosition then
   local measured,record,problem=invoke(function() return self.adapter:record(entry.ticket,response) end)
   if measured and record then result.measurement=record;self.stats.measurementCount+=1
   else result.measurementError=tostring(if measured then problem else record) end
  elseif entry.ticket then result.measurementError="server-reference-unavailable" end
 else self.stats.rejected+=1 end
 self.lastResult=table.freeze(result)
 self:_status(if response.accepted then "Confirmed" else "ServerRejected",self.lastResult)
 return self.lastResult
end

function ClientController:step(now)
 if self.destroyed then return end
 if now==nil then
  local ok,value=invoke(self.clock)
  if not ok then return end
  now=value
 end
 if not finite(now) then return end
 for id,entry in self.pending do
  if now-entry.sentAt&gt;=entry.timeout then
   self.pending[id]=nil;self.pendingCount-=1;self.stats.timedOut+=1
   self:_status("Timeout",{shotId=id,mode=entry.request.mode,reason="server-response-timeout"})
  end
 end
end
function ClientController:summary()
 local result=table.clone(self.stats)
 result.pending=self.pendingCount
 return result
end
function ClientController:destroy()
 if self.destroyed then return end
 self.destroyed=true
 table.clear(self.pending);self.pendingCount=0
 self.adapter:destroy()
 self.api=nil;self.send=nil;self.clock=nil;self.getCameraAim=nil;self.getOrigin=nil;self.isEquipped=nil;self.onStatus=nil;self.getWeapon=nil
end
return ClientController
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX13">
        <Properties>
          <string name="Name">ServerController</string>
          <ProtectedString name="Source">--!nonstrict
-- Authoritative controller for the OWNED Studio Tool. No game-specific hooks.
-- All Roblox accesses live in the injected native wrapper, so this exact
-- controller can also be exercised by deterministic tests.
local WeaponSettings = if script then require(script.Parent.WeaponSettings) else require("./WeaponSettings")
local WeaponProfiles = if script then require(script.Parent.WeaponProfiles) else require("./WeaponProfiles")
local Spread = if script then require(script.Parent.Spread) else require("./Spread")
local ServerController = {}
ServerController.__index = ServerController
local fields = {
	sessionId = true, shotId = true, ticketId = true, mode = true,
	capturedAt = true, origin = true, aimpoint = true, targetUserId = true,
	targetCharacter = true, partName = true, sampleTime = true, weaponId = true,
}
local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end
local function integer(value)
	return finite(value) and value &gt;= 1 and value &lt;= 1e12 and value % 1 == 0
end
local function finiteVector(value)
	-- Native wiring supplies an isVector predicate requiring real Vector3.
	-- Table vectors are allowed only for the isolated CLI arithmetic adapter.
	if typeof(value) ~= "Vector3" and type(value) ~= "table" then return false end
	return finite(value.X) and finite(value.Y) and finite(value.Z)
end
local function health(humanoid)
	return humanoid and finite(humanoid.Health) and humanoid.Health &gt; 0
end
local function magnitude(vector)
	return math.sqrt(vector.X * vector.X + vector.Y * vector.Y + vector.Z * vector.Z)
end
local function response(request, reason)
	local result = { accepted = false, reason = reason, hit = false, selectedTargetHit = false, damageApplied = 0 }
	if type(request) == "table" and getmetatable(request) == nil then
		if type(request.sessionId) == "string" and #request.sessionId &lt;= 64 then result.sessionId = request.sessionId end
		if integer(request.shotId) then result.shotId = request.shotId end
		if integer(request.ticketId) then result.ticketId = request.ticketId end
		if request.mode == "Normal" or request.mode == "Locked" then result.mode = request.mode end
		if WeaponProfiles.validId(request.weaponId) then result.weaponId=request.weaponId end
	end
	return result
end

function ServerController.new(options)
	assert(type(options) == "table", "Server controller options required")
	for _, name in { "clock", "getEquippedWeapon", "getTarget", "raycast", "describeHit", "applyDamage" } do
		assert(type(options[name]) == "function", name .. " callback required")
	end
	assert(options.isVector == nil or type(options.isVector) == "function", "isVector must be a function")
	local profiles
	if options.profiles then
		profiles={}
		for id,profile in options.profiles do profiles[id]=WeaponProfiles.normalize(id,profile) end
		for _,profile in profiles do
			if profile.Kind=="Projectile" then
				assert(type(options.launchProjectile)=="function" and type(options.onResult)=="function","Native projectile launch/result callbacks required")
			end
		end
	end
	return setmetatable({ settings = WeaponSettings.new(options.settings), callbacks = options, profiles=profiles,
		states = {}, jobs={},nextJob=0,jobCount=0,destroyed = false }, ServerController)
end

function ServerController:_result(context,entries,reason,endPosition)
	local callbacks,request,profile=context.callbacks,context.request,context.profile
	local isVector=callbacks.isVector or finiteVector
	local referenceTime=callbacks.clock()
	assert(finite(referenceTime),"Reference clock unavailable after collision query")
	local actualPosition
	if context.target then
		local ok,value=pcall(function() return context.target.part.Position end)
		if ok and isVector(value) and finiteVector(value) then actualPosition=value end
	end
	local result={sessionId=request.sessionId,shotId=request.shotId,ticketId=request.ticketId,weaponId=request.weaponId,
		accepted=true,mode=request.mode,referenceTime=referenceTime,serverTime=referenceTime,
		hit=false,selectedTargetHit=false,damageApplied=0,origin=context.origin,
		impactPosition=endPosition,physicsKind=profile.Kind,pelletCount=#entries,pelletHits=0,pellets={},reason=reason or "miss"}
	for _,entry in entries do
		local pellet={hit=entry.result~=nil,impactPosition=entry.endPosition,selectedTargetHit=false,damageApplied=0}
		if entry.result then
			local description=callbacks.describeHit(entry.result,context.player)
			assert(type(description)=="table" and isVector(description.position) and finiteVector(description.position),"Invalid actual impact description")
			pellet.impactPosition=description.position;pellet.hitName=description.name
			pellet.selectedTargetHit=context.target~=nil and description.character==context.target.character
			if not result.hit then result.impactPosition=description.position;result.hitName=description.name;result.hitPlayerUserId=description.playerUserId end
			result.hit=true;result.pelletHits+=1
			if pellet.selectedTargetHit then result.selectedTargetHit=true end
			if description.humanoid and description.character~=context.weapon.character and health(description.humanoid) then
				local damage=callbacks.applyDamage(description.humanoid,profile.Damage)
				assert(type(damage)=="table" and finite(damage.before) and finite(damage.after),"Damage callback must return measured health")
				pellet.damageApplied=math.max(0,damage.before-damage.after)
				result.damageApplied+=pellet.damageApplied
			end
		end
		table.insert(result.pellets,pellet)
	end
	if result.selectedTargetHit then result.reason="selected-target-hit" elseif result.hit then result.reason="surface-impact" end
	if context.target then
		result.targetUserId=context.target.player.UserId;result.character=context.target.character;result.actualPosition=actualPosition
	end
	return result
end

function ServerController:_launch(context,direction)
	if self.jobCount&gt;=self.settings.MaxProjectiles then return response(context.request,"projectile-capacity") end
	local count=0;for _,job in self.jobs do if job.context.player==context.player then count+=1 end end
	if count&gt;=self.settings.MaxProjectilesPerPlayer then return response(context.request,"player-projectile-capacity") end
	self.nextJob+=1
	local id=self.nextJob
	local job={context=context,done=false,published=false}
	self.jobs[id]=job;self.jobCount+=1
	local function complete(hit,reason,position)
		if job.done or self.destroyed then return end
		job.done=true;self.jobs[id]=nil;self.jobCount-=1
		local ok,result=pcall(function()
			local isVector=context.callbacks.isVector or finiteVector
			if not isVector(position) or not finiteVector(position) then return response(context.request,"invalid-projectile-reference") end
			if reason~="impact" and reason~="range-expired" and reason~="lifetime-expired" then
				return response(context.request,"projectile-error: "..tostring(reason))
			end
			return self:_result(context,{{result=hit,endPosition=position}},reason,position)
		end)
		if not ok then local detail=result;result=response(context.request,"server-error");result.error=tostring(detail) end
		if job.published then context.callbacks.onResult(context.player,result) else job.result=result end
	end
	local launched,cancel=pcall(context.callbacks.launchProjectile,context.origin,direction*context.profile.Speed,
		context.profile,context.weapon.character,complete)
	if not launched or type(cancel)~="function" then
		if not job.done then self.jobs[id]=nil;self.jobCount-=1;job.done=true end
		error("Physical projectile launch failed: "..tostring(cancel))
	end
	job.cancel=cancel
	if job.result then return job.result end
	job.published=true
	return {sessionId=context.request.sessionId,shotId=context.request.shotId,ticketId=context.request.ticketId,
		weaponId=context.request.weaponId,accepted=true,pending=true,stage="Launched",mode=context.request.mode}
end

function ServerController:_process(player, request)
	local rejected = response(request, "invalid-request")
	if self.destroyed then rejected.reason = "destroyed"; return rejected end
	if type(request) ~= "table" or getmetatable(request) ~= nil then return rejected end
	for key in request do if not fields[key] then rejected.reason = "unknown-field"; return rejected end end
	if type(request.sessionId) ~= "string" or #request.sessionId &lt; 1 or #request.sessionId &gt; 64 or not integer(request.shotId) then return rejected end
	if request.mode ~= "Normal" and request.mode ~= "Locked" then rejected.reason = "invalid-mode"; return rejected end
	if request.ticketId ~= nil and not integer(request.ticketId) then rejected.reason = "invalid-ticket"; return rejected end
	local profile
	if self.profiles then
		profile=self.profiles[request.weaponId]
		if not WeaponProfiles.validId(request.weaponId) or not profile then rejected.reason="unsupported-weapon";return rejected end
	elseif request.weaponId~=nil then rejected.reason="unsupported-weapon";return rejected end
	local settings, callbacks = self.settings, self.callbacks
	local now = callbacks.clock()
	if not finite(now) then rejected.reason = "invalid-server-clock"; return rejected end
	if not finite(request.capturedAt) or request.capturedAt &gt; now + settings.ClockTolerance
		or now - request.capturedAt &gt; settings.RequestMaxAge then rejected.reason = "stale-request"; return rejected end
	local isVector = callbacks.isVector or finiteVector
	if not isVector(request.origin) or not finiteVector(request.origin) or not isVector(request.aimpoint) or not finiteVector(request.aimpoint) then
		rejected.reason = "invalid-vectors"; return rejected
	end
	if not player or not finite(player.UserId) or player.UserId % 1 ~= 0 then rejected.reason = "invalid-player"; return rejected end
	if request.mode == "Locked" then
		if not finite(request.targetUserId) or request.targetUserId % 1 ~= 0 or request.targetUserId == player.UserId
			or not settings.AllowedParts[request.partName] or request.targetCharacter == nil then rejected.reason = "invalid-target"; return rejected end
		if not finite(request.sampleTime) or request.sampleTime &gt; now + settings.ClockTolerance
			or now - request.sampleTime &gt; settings.RequestMaxAge then rejected.reason = "stale-sample"; return rejected end
	elseif request.targetUserId ~= nil or request.targetCharacter ~= nil or request.partName ~= nil
		or request.sampleTime ~= nil or request.ticketId ~= nil then
		rejected.reason = "unexpected-target-fields"; return rejected
	end
	local state = self.states[player]
	if not state then
		state = { nextFire = -math.huge, sessions = {}, order = {} }
		self.states[player] = state
	end
	local prior = state.sessions[request.sessionId]
	if prior and request.shotId &lt;= prior then rejected.reason = "duplicate-shot"; return rejected end
	if not prior then
		table.insert(state.order, request.sessionId)
		if #state.order &gt; settings.MaxSessionsPerPlayer then state.sessions[table.remove(state.order, 1)] = nil end
	end
	state.sessions[request.sessionId] = request.shotId
	if now &lt; state.nextFire then rejected.reason = "cooldown"; return rejected end
	local weapon = callbacks.getEquippedWeapon(player)
	if type(weapon) ~= "table" or not weapon.tool or not weapon.character or not health(weapon.humanoid)
		or not isVector(weapon.origin) or not finiteVector(weapon.origin) then rejected.reason = "weapon-not-equipped"; return rejected end
	local authoritativeOrigin = weapon.origin
	if profile and weapon.profileId~=request.weaponId then rejected.reason="weapon-profile-mismatch";return rejected end
	profile=profile or {Kind="Hitscan",Range=settings.Range,Cooldown=settings.Cooldown,Damage=settings.Damage,Pellets=1,SpreadDegrees=0}
	if magnitude(request.origin - authoritativeOrigin) &gt; settings.MaxOriginDistance then rejected.reason = "invalid-origin"; return rejected end
	local delta = request.aimpoint - authoritativeOrigin
	local distance = magnitude(delta)
	if not finite(distance) or distance &lt;= 0.001 then rejected.reason = "degenerate-aimpoint"; return rejected end
	if distance &gt; settings.MaxAimDistance then rejected.reason = "aimpoint-out-of-range"; return rejected end
	local target
	if request.mode == "Locked" then
		target = callbacks.getTarget(request.targetUserId, request.partName, request.targetCharacter)
		if type(target) ~= "table" or not target.player or target.player.UserId ~= request.targetUserId
			or target.character ~= request.targetCharacter or not target.part or not health(target.humanoid)
			or not isVector(target.position) or not finiteVector(target.position) then rejected.reason = "target-lost"; return rejected end
		if magnitude(target.position - authoritativeOrigin) &gt; profile.Range then rejected.reason = "target-out-of-range"; return rejected end
	end
	-- Rate is consumed before any raycast/damage callback, including a failed
	-- callback. Retrying cannot cause duplicated physical damage.
	state.nextFire = now + profile.Cooldown
	local directions=Spread.directions(delta,profile.Pellets,profile.SpreadDegrees,callbacks.random,callbacks.makeVector)
	local context={callbacks=callbacks,player=player,request=request,profile=profile,target=target,weapon=weapon,origin=authoritativeOrigin}
	if profile.Kind=="Projectile" then return self:_launch(context,directions[1]) end
	local entries={}
	for _,direction in directions do
		local rayDirection=direction*profile.Range
		table.insert(entries,{result=callbacks.raycast(authoritativeOrigin,rayDirection,weapon.character,profile),endPosition=authoritativeOrigin+rayDirection})
	end
	return self:_result(context,entries,nil,entries[1].endPosition)
end

function ServerController:process(player, request)
	local ok, result = pcall(self._process, self, player, request)
	if ok then return result end
	local rejected = response(request, "server-error")
	local stringifyOK, detail = pcall(tostring, result)
	rejected.error = if stringifyOK then detail else "Server callback failed"
	return rejected
end
function ServerController:removePlayer(player)
	self.states[player] = nil
	for id,job in self.jobs do
		if job.context.player==player then
			job.done=true;self.jobs[id]=nil;self.jobCount-=1
			if job.cancel then pcall(job.cancel) end
		end
	end
end
function ServerController:destroy()
	if self.destroyed then return end
	self.destroyed = true
	for _,job in self.jobs do job.done=true;if job.cancel then pcall(job.cancel) end end
	table.clear(self.jobs);self.jobCount=0
	table.clear(self.states)
	self.callbacks = nil
end
return ServerController
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX14">
        <Properties>
          <string name="Name">Spread</string>
          <ProtectedString name="Source">--!nonstrict
-- Server-selected uniform cone spread. The aim point remains the cone axis;
-- neither a target nor prediction proximity is used to decide a pellet hit.
local Spread = {}
function Spread.directions(direction,count,degrees,sample,makeVector)
 assert(type(count)=="number" and count%1==0 and count&gt;=1 and count&lt;=32,"Invalid pellet count")
 assert(type(degrees)=="number" and degrees==degrees and degrees&gt;=0 and degrees&lt;=20,"Invalid spread angle")
 local length=direction.Magnitude
 assert(length&gt;0 and length&lt;math.huge,"Invalid spread direction")
 local forward=direction/length
 if degrees==0 then
  local results={}
  for _=1,count do table.insert(results,forward) end
  return results
 end
 assert(type(sample)=="function" and type(makeVector)=="function","Server random/vector callbacks required for spread")
 local ax,ay,az=if math.abs(forward.Y)&lt;0.99 then 0 else 1,if math.abs(forward.Y)&lt;0.99 then 1 else 0,0
 local right=makeVector(forward.Y*az-forward.Z*ay,forward.Z*ax-forward.X*az,forward.X*ay-forward.Y*ax)
 right=right/right.Magnitude
 local up=makeVector(right.Y*forward.Z-right.Z*forward.Y,right.Z*forward.X-right.X*forward.Z,right.X*forward.Y-right.Y*forward.X)
 local results={}
 local minimumCos=math.cos(math.rad(degrees))
 for _=1,count do
  local u,v=sample(),sample()
  assert(type(u)=="number" and type(v)=="number" and u&gt;=0 and u&lt;=1 and v&gt;=0 and v&lt;=1,"Invalid server random sample")
  local cosine=1-u*(1-minimumCos)
  local sine=math.sqrt(math.max(0,1-cosine*cosine))
  local angle=2*math.pi*v
  table.insert(results,forward*cosine+(right*math.cos(angle)+up*math.sin(angle))*sine)
 end
 return results
end
return Spread
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX15">
        <Properties>
          <string name="Name">ProjectileTracker</string>
          <ProtectedString name="Source">--!nonstrict
-- Reads positions of a REAL server-owned physical Part in native wiring.
-- Sweeps each observed segment through Workspace:Raycast; no analytic target
-- proximity or predicted positions manufacture a collision.
local ProjectileTracker={}
ProjectileTracker.__index=ProjectileTracker
local function finite(n) return type(n)=="number" and n==n and math.abs(n)&lt;math.huge end
local function vector(v)
 local ok,x,y,z=pcall(function() return v.X,v.Y,v.Z end)
 return ok and finite(x) and finite(y) and finite(z)
end
function ProjectileTracker.new(options)
 for _,name in {"clock","getPosition","raycast","onComplete","dispose"} do assert(type(options[name])=="function",name.." callback required") end
 assert(vector(options.origin) and finite(options.range) and options.range&gt;0 and finite(options.lifetime) and options.lifetime&gt;0,"Invalid projectile limits")
 local started=options.clock()
 assert(finite(started),"Invalid projectile clock")
 return setmetatable({options=options,last=options.origin,started=started,traveled=0,done=false},ProjectileTracker)
end
function ProjectileTracker:_finish(result,reason,position)
 if self.done then return end
 self.done=true
 local options=self.options
 -- Remove the physical resource before a callback can re-enter this tracker.
 local disposed,disposeError=pcall(options.dispose)
 local completed,completionError=pcall(options.onComplete,result,reason,position,self.traveled)
 self.options=nil
 if not disposed then error("Projectile cleanup failed: "..tostring(disposeError)) end
 if not completed then error("Projectile completion failed: "..tostring(completionError)) end
end
function ProjectileTracker:step(now)
 if self.done then return end
 local options=self.options
 now=now or options.clock()
 if not finite(now) or now&lt;self.started then self:_finish(nil,"invalid-clock",self.last);return end
 local ok,current=pcall(options.getPosition)
 if not ok or not vector(current) then self:_finish(nil,"projectile-lost",self.last);return end
 local delta=current-self.last
 local length=delta.Magnitude
 if not finite(length) then self:_finish(nil,"invalid-projectile-position",self.last);return end
 if length&gt;0 then
  local distance=math.min(length,math.max(0,options.range-self.traveled))
  local direction=delta/length*distance
  local hitOK,hit=pcall(options.raycast,self.last,direction)
  if not hitOK then self:_finish(nil,"raycast-error: "..tostring(hit),self.last);return end
  self.traveled+=distance
  local endPosition=self.last+direction
  if hit then self:_finish(hit,"impact",endPosition);return end
  self.last=endPosition
  if self.traveled&gt;=options.range then self:_finish(nil,"range-expired",self.last);return end
 end
 if now-self.started&gt;=options.lifetime then self:_finish(nil,"lifetime-expired",self.last) end
end
function ProjectileTracker:cancel()
 if self.done then return end
 self.done=true
 local options=self.options;self.options=nil
 options.dispose()
end
return ProjectileTracker
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX16">
        <Properties>
          <string name="Name">WeaponManager</string>
          <ProtectedString name="Source">--!nonstrict
-- One selection/Memory session and one shot-ID stream across compatible Tools.
-- Registration is explicit: this never discovers or hooks foreign weapons.
local ClientController=if script then require(script.Parent.ClientController) else require("./ClientController")
local WeaponProfiles=if script then require(script.Parent.WeaponProfiles) else require("./WeaponProfiles")
local WeaponManager={}
WeaponManager.__index=WeaponManager
local function finite(n) return type(n)=="number" and n==n and math.abs(n)&lt;math.huge end
local function disconnect(list)
 for _,connection in list do pcall(function() connection:Disconnect() end) end
 table.clear(list)
end
function WeaponManager.new(options)
 assert(type(options)=="table" and type(options.api)=="table" and type(options.api.SetWeaponProfile)=="function","Current SEDWARE profile API required")
 assert(type(options.api.SetPredictionOrigin)=="function","Current SEDWARE muzzle-origin API required")
 for _,name in {"clock","send","getOrigin","getCameraAim","isEquipped"} do assert(type(options[name])=="function",name.." callback required") end
 local self=setmetatable({options=options,api=options.api,profiles={},controllers={},tools={},active=nil,
  held=false,nextFire=-math.huge,destroyed=false},WeaponManager)
 local configured=options.profiles or WeaponProfiles.defaults()
 for id,profile in configured do self:register(id,profile) end
 local session=self.api.session
 if session then
  self.saved={slot=session.config.WeaponProfile,custom=table.clone(session.config.Profiles.Custom),
   label=session.prediction and session.prediction.weaponProfileLabel,origin=session.predictionOriginProvider}
 end
 local function origin() return if self.active then options.getOrigin(self.active.tool) else nil end
 local adapter=options.adapter or self.api.CreateShotAdapter(nil,{getOrigin=origin,maxAge=8})
 self.client=ClientController.new({api=self.api,clock=options.clock,sessionId=options.sessionId,adapter=adapter,
  getOrigin=origin,getCameraAim=function() return if self.active then options.getCameraAim(self.active.profile) else nil end,
  isEquipped=function() return self.active~=nil and options.isEquipped(self.active.tool)==true end,
  getWeapon=function() return if self.active then {id=self.active.profile.Id,timeout=if self.active.profile.Kind=="Projectile" then self.active.profile.Lifetime+2 else 2} else nil end,
  send=function(request)
   local profile=self.profiles[request.weaponId]
   assert(profile,"Unregistered weapon controller")
   local context={profile=profile,aimpoint=request.aimpoint,mode=request.mode,
    targetUserId=request.targetUserId,targetCharacter=request.targetCharacter}
   local controller=self.controllers[request.weaponId] or options.send
   return controller(request,context)
  end,
  onStatus=options.onStatus,maxPending=64,timeout=2})
 local originSet,problem=self.api.SetPredictionOrigin(origin)
 if not originSet then self.client:destroy();error("Cannot set owned muzzle origin: "..tostring(problem)) end
 return self
end
function WeaponManager:register(id,profile)
 assert(not self.destroyed,"WeaponManager is destroyed")
 assert(self.profiles[id]==nil,"Weapon profile already registered")
 local count=0;for _ in self.profiles do count+=1 end
 assert(count&lt;64,"Too many registered weapon profiles")
 self.profiles[id]=WeaponProfiles.normalize(id,profile)
 return self.profiles[id]
end
function WeaponManager:registerController(id,callback)
 assert(not self.destroyed and self.profiles[id],"Registered weapon profile required")
 assert(type(callback)=="function","Owned controller callback required")
 self.controllers[id]=callback
end
function WeaponManager:equip(tool,id)
 if self.destroyed then return false,"destroyed" end
 local profile=self.profiles[id]
 if not profile then return false,"unsupported-weapon" end
 if tool==nil or self.options.isEquipped(tool)~=true then return false,"weapon-not-equipped" end
 if self.active and self.active.tool==tool and self.active.profile.Id==id then return true end
 local ok,message=self.api.SetWeaponProfile("Custom",WeaponProfiles.prediction(profile),id)
 if not ok then return false,"prediction-profile-rejected: "..tostring(message) end
 self.held=false
 self.active={tool=tool,profile=profile}
 if self.options.onWeaponChanged then pcall(self.options.onWeaponChanged,profile,tool) end
 return true
end
function WeaponManager:unequip(tool)
 if self.active and (tool==nil or self.active.tool==tool) then self.held=false;self.active=nil end
 -- Selection and Memory deliberately belong to SEDWARE, not the equipped Tool.
end
function WeaponManager:fire()
 if self.destroyed then return nil,"destroyed" end
 if not self.active then return nil,"no-compatible-weapon" end
 if self.options.isEquipped(self.active.tool)~=true then self:unequip();return nil,"weapon-not-equipped" end
 local now=self.options.clock()
 if not finite(now) then return nil,"invalid-clock" end
 if now+1e-7&lt;self.nextFire then return nil,"client-cooldown" end
 local profile=self.active.profile
 local request,message=self.client:fire()
 if request then self.nextFire=now+profile.Cooldown end
 return request,message
end
function WeaponManager:press()
 if self.destroyed or not self.active then return nil,"no-compatible-weapon" end
 self.held=self.active.profile.Automatic
 return self:fire()
end
function WeaponManager:release() self.held=false end
function WeaponManager:step(now)
 if self.destroyed then return end
 now=now or self.options.clock()
 if not finite(now) then self.held=false;return end
 self.client:step(now)
 if self.held and self.active and self.active.profile.Automatic and now+1e-7&gt;=self.nextFire then
  local cooldown=self.active.profile.Cooldown
  local request,problem=self:fire()
  -- No catch-up bursts. A failed held shot backs off rather than spamming.
  if not request then self.nextFire=now+cooldown end
 end
end
function WeaponManager:track(tool,id)
 assert(not self.destroyed and self.profiles[id],"Compatible registered Tool required")
 if self.tools[tool] then return end
 assert(tool:IsA("Tool"),"Only an authorized Tool can be tracked")
 local bindings={};self.tools[tool]=bindings
 local function bind(signal,callback)
  local connection=signal:Connect(callback)
  assert(connection and connection.Connected,"Weapon Tool event failed to connect")
  table.insert(bindings,connection)
 end
 local function equipped()
  local ok,message=self:equip(tool,id)
  if not ok and self.options.onStatus then pcall(self.options.onStatus,"ClientRejected",{reason=message}) end
  return ok
 end
 bind(tool.Equipped,equipped)
 bind(tool.Unequipped,function() self:unequip(tool) end)
 bind(tool.Activated,function()
  if self.options.isEquipped(tool)==true and equipped() then self:press() end
 end)
 bind(tool.Deactivated,function() if self.active and self.active.tool==tool then self:release() end end)
 bind(tool.AncestryChanged,function() if self.active and self.active.tool==tool and self.options.isEquipped(tool)~=true then self:unequip(tool) end end)
 bind(tool.Destroying,function() self:untrack(tool) end)
 if self.options.isEquipped(tool)==true then equipped() end
end
function WeaponManager:untrack(tool)
 self:unequip(tool)
 local list=self.tools[tool]
 if list then disconnect(list);self.tools[tool]=nil end
end
function WeaponManager:receive(response)
 if self.destroyed then return nil,"destroyed" end
 return self.client:receive(response)
end
function WeaponManager:summary() return self.client:summary() end
function WeaponManager:destroy()
 if self.destroyed then return end
 self.destroyed=true;self.held=false;self.active=nil
 for tool in self.tools do self:untrack(tool) end
 self.client:destroy()
 if self.saved and self.api.session and not self.api.session.destroyed then
  self.api.SetWeaponProfile("Custom",self.saved.custom)
  self.api.SetWeaponProfile(self.saved.slot,nil,self.saved.label)
  self.api.SetPredictionOrigin(self.saved.origin)
 end
 table.clear(self.profiles);table.clear(self.controllers)
 self.options=nil;self.api=nil
end
return WeaponManager
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX17">
        <Properties>
          <string name="Name">NativeVerification</string>
          <ProtectedString name="Source">--!nonstrict
-- Opt-in F6 exercise of ACTUAL equipped Tool.Activated + server responses.
-- This does not inject keyboard input, predict collisions or claim a pass from
-- mathematical errors. A native pass requires confirmed target contact/damage.
local NativeVerification={}
NativeVerification.__index=NativeVerification
function NativeVerification.new(options)
 for _,name in {"clock","wait","getTool","getHumanoid","getCameraAim","beginRun","endRun","publish"} do
  assert(type(options[name])=="function",name.." native verification callback required")
 end
 return setmetatable({options=options,running=false,destroyed=false,records={},order={},observedC=false,runId=nil},NativeVerification)
end
function NativeVerification:noteC()
 self.observedC=true
 self.observedTarget=self.options.api.GetLockedTarget()
 self.observedCharacter=self.observedTarget and self.observedTarget.Character
end
function NativeVerification:record(kind,details)
 if not self.running then return end
 if kind=="Pending" then
  if #self.order&gt;=64 then self.overflow=true;return end
  local request=details.request
  local profile=self.options.manager.profiles[request.weaponId]
  local ok,aim=pcall(self.options.getCameraAim,profile)
  self.records[request.shotId]={request=request,normalAim=if ok then aim else nil}
  table.insert(self.order,request.shotId)
 elseif kind=="Confirmed" or kind=="ServerRejected" then
  local record=self.records[details.shotId]
  if record then record.result=details end
 elseif kind=="Timeout" then
  local record=self.records[details.shotId]
  if record then record.error="server-response-timeout" end
 end
end
function NativeVerification:_waitUntil(callback,seconds)
 local deadline=self.options.clock()+seconds
 while not self.destroyed and self.running and self.options.clock()&lt;deadline do
  if callback() then return true end
  self.options.wait(0.05)
 end
 return callback() and not self.destroyed
end
function NativeVerification:_exercise(id,target)
 local o=self.options
 local profile=o.manager.profiles[id]
 local tool=o.getTool(id)
 assert(tool,"Native test Tool missing: "..id)
 o.manager:release()
 o.getHumanoid():EquipTool(tool)
 assert(self:_waitUntil(function() return o.manager.active and o.manager.active.profile.Id==id end,2),"Equip did not reach WeaponManager: "..id)
 assert(o.api.GetLockedTarget()==target,"Weapon change lost the locked target")
 local dotVisible=o.api.session.overlay.dot.Visible==true
 local delay=math.max(0,o.manager.nextFire-o.clock())+0.1
 o.wait(delay)
 local before=#self.order
 tool:Activate() -- Actual Tool event path, not a direct call to a mock fire API.
 if profile.Automatic then o.wait(profile.Cooldown*2.4) else o.wait(0.05) end
 tool:Deactivate();o.manager:release()
 assert(self:_waitUntil(function()
  if #self.order&lt;=before then return false end
  for i=before+1,#self.order do local r=self.records[self.order[i]];if not r.result and not r.error then return false end end
  return true
 end,profile.Lifetime+2.5),"No authoritative final response: "..id)
 local record={weaponId=id,kind=profile.Kind,dotVisible=dotVisible,lockRetained=o.api.GetLockedTarget()==target,
  shots=0,targetHits=0,damageApplied=0,allAccepted=true,allNative=true,aimDiffers=false}
 for i=before+1,#self.order do
  local item=self.records[self.order[i]]
  local result=item.result
  record.shots+=1
  if not result or not result.accepted then record.allAccepted=false end
  if not result or result.engine~="RobloxWorkspace" or result.physicsKind~=profile.Kind then record.allNative=false end
  if result and result.selectedTargetHit then record.targetHits+=1;record.damageApplied+=result.damageApplied or 0 end
  if item.normalAim and (item.normalAim-item.request.aimpoint).Magnitude&gt;1 then record.aimDiffers=true end
 end
 record.passed=record.lockRetained and record.dotVisible and record.allAccepted and record.allNative
  and record.targetHits&gt;0 and record.damageApplied&gt;0 and (not profile.Automatic or record.shots&gt;=2)
 return record
end
function NativeVerification:run()
 if self.destroyed or self.running then return nil,"verification-already-running-or-destroyed" end
 local o=self.options
 local target=o.api.GetLockedTarget()
 if not target or not self.observedC or target~=self.observedTarget or target.Character~=self.observedCharacter then
  return nil,"Press C to select the current real player before F6"
 end
 local begun,setup=pcall(o.beginRun,target.UserId)
 if not begun or type(setup)~="table" or not setup.ok then return nil,"Native setup failed: "..tostring(if begun and type(setup)=="table" then setup.reason else setup) end
 self.runId=setup.runId;self.running=true;self.records={};self.order={};self.overflow=false
 local report={runId=setup.runId,runtime=o.runtimeName or "Unknown",observedC=self.observedC,
  targetUserId=target.UserId,startedAt=o.clock(),weapons={},passed=false}
 local ok,problem=xpcall(function()
  local ids={};for id in o.manager.profiles do table.insert(ids,id) end;table.sort(ids)
  for _,id in ids do
   assert(not self.destroyed,"Native verification cancelled")
   table.insert(report.weapons,self:_exercise(id,target))
  end
  o.api.UnlockTarget()
  assert(o.api.GetLockedTarget()==nil,"Unlock did not clear selection")
  local id=if o.manager.profiles.Pistol then "Pistol" else ids[1]
  o.getHumanoid():EquipTool(assert(o.getTool(id)))
  assert(self:_waitUntil(function() return o.manager.active and o.manager.active.profile.Id==id end,2),"Normal-fire Tool missing")
  o.wait(math.max(0,o.manager.nextFire-o.clock())+0.1)
  local before=#self.order
  local tool=o.getTool(id);tool:Activate();o.wait(0.05);tool:Deactivate();o.manager:release()
  assert(self:_waitUntil(function() return #self.order&gt;before and self.records[self.order[before+1]].result~=nil end,3),"Normal fire was not confirmed")
  local normal=self.records[self.order[before+1]]
  report.normalFire=normal.request.mode=="Normal" and normal.request.targetUserId==nil
   and normal.result.accepted==true and normal.result.engine=="RobloxWorkspace"
  local allPassed,aimDiffers=true,false
  for _,entry in report.weapons do allPassed=allPassed and entry.passed;aimDiffers=aimDiffers or entry.aimDiffers end
  report.aimDiffersFromMira=aimDiffers
  report.passed=allPassed and report.normalFire and aimDiffers and not self.overflow and report.runtime=="RobloxStudio"
 end,debug.traceback)
 if not ok then report.error=tostring(problem) end
 self.running=false
 pcall(o.endRun,self.runId);self.runId=nil
 report.finishedAt=o.clock()
 o.publish(report)
 return report
end
function NativeVerification:destroy()
 if self.destroyed then return end
 self.destroyed=true;self.running=false
 if self.runId then
  local id=self.runId;self.runId=nil
  -- Native cleanup supplies a nonblocking endpoint wrapper; no shot is claimed.
  pcall(self.options.endRun,id)
 end
 table.clear(self.records);table.clear(self.order)
end
return NativeVerification
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX19">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX20">
      <Properties>
        <string name="Name">SEDWAREWeaponServer</string>
        <ProtectedString name="Source">--!nonstrict
-- OWNED STUDIO EXPERIENCE ONLY. This script creates and validates its own Tool
-- and remotes; it never connects to Da Hood weapons or protected communications.
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then
	print("[SEDWARE Weapon] SKIPPED: this owned weapon demonstration requires Roblox Studio")
	return
end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local HttpService = game:GetService("HttpService")
local modules = ReplicatedStorage:WaitForChild("SEDWAREWeaponModules", 10)
assert(modules and modules:IsA("Folder"), "[SEDWARE Weapon] owned weapon module folder missing or invalid")
local function loadRequired(name)
	local source = modules:WaitForChild(name, 10)
	assert(source and source:IsA("ModuleScript"), "[SEDWARE Weapon] required module missing or invalid: " .. name)
	local ok, value = pcall(require, source)
	assert(ok and type(value) == "table", "[SEDWARE Weapon] module failed: " .. name .. ": " .. tostring(value))
	return value
end
local WeaponSettings = loadRequired("WeaponSettings")
local ServerController = loadRequired("ServerController")
local WeaponProfiles = loadRequired("WeaponProfiles")
local ProjectileTracker = loadRequired("ProjectileTracker")
local settings = WeaponSettings.new()
local profiles = WeaponProfiles.defaults()

local previous = ReplicatedStorage:FindFirstChild("SEDWAREWeaponRemotes")
assert(not previous or previous:IsA("Folder") and previous:GetAttribute("OwnedSEDWAREWeapon") == true,
	"SEDWARE owned weapon remote name conflict")
if previous then
	local stop = previous:FindFirstChild("StopOwner")
	assert(stop and stop:IsA("BindableEvent"), "SEDWARE prior weapon owner cannot be stopped safely")
	stop:Fire()
	assert(previous.Parent == nil, "SEDWARE prior weapon owner did not clean up")
end
local folder = Instance.new("Folder")
folder.Name = "SEDWAREWeaponRemotes"
folder:SetAttribute("OwnedSEDWAREWeapon", true)
local Fire = Instance.new("RemoteEvent")
Fire.Name = "Fire"; Fire.Parent = folder
local Result = Instance.new("RemoteEvent")
Result.Name = "Result"; Result.Parent = folder
local StopOwner = Instance.new("BindableEvent")
StopOwner.Name = "StopOwner"; StopOwner.Parent = folder
local Verification = Instance.new("RemoteFunction")
Verification.Name = "Verification"; Verification.Parent = folder
assert(not Workspace:FindFirstChild("SEDWAREWeaponPhysics"),"SEDWARE physics namespace conflict")
local physicsFolder=Instance.new("Folder")
physicsFolder.Name="SEDWAREWeaponPhysics";physicsFolder.Parent=Workspace

-- A real equipped Tool produces the origin used by the server raycast.
local templates={}
for id,profile in profiles do
local template = Instance.new("Tool")
template.Name = profile.Name
template.RequiresHandle = true
template.CanBeDropped = false
template.ToolTip = "SEDWARE owned Studio test weapon: C locks; click fires"
template:SetAttribute("OwnedSEDWAREWeapon", true)
template:SetAttribute("SEDWAREProfileId",id)
local handle = Instance.new("Part")
handle.Name = "Handle"
handle.Size = Vector3.new(0.45, 0.6, 1.8)
handle.Color = Color3.fromRGB(255, 105, 180)
handle.Material = Enum.Material.Metal
handle.CanCollide = false
handle.CanTouch = false
handle.CanQuery = false
handle.Massless = true
handle.Parent = template
local muzzle = Instance.new("Attachment")
muzzle.Name = "Muzzle"
muzzle.Position = Vector3.new(0, 0, -0.9)
muzzle.Parent = handle
templates[id]=template
end

local connections, playerConnections, playerTools = {}, {}, {}
local trackers,verificationRuns={},{}
local destroyed = false
local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end
local function vector(value)
	return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
end
local function query(from,direction,ignoreCharacter)
	local parameters=RaycastParams.new()
	parameters.FilterType=Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances={ignoreCharacter,physicsFolder}
	return Workspace:Raycast(from,direction,parameters)
end
local function trace(from,to)
	local distance=(to-from).Magnitude
	if distance&lt;0.001 then return end
	local part=Instance.new("Part")
	part.Name="AuthoritativeRayTrace";part.Anchored=true;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
	part.Material=Enum.Material.Neon;part.Color=Color3.fromRGB(255,105,180)
	part.Size=Vector3.new(0.035,0.035,distance)
	part.CFrame=CFrame.lookAt((from+to)/2,to);part.Parent=physicsFolder
	Debris:AddItem(part,0.1)
end
local function deliver(player,result)
	if destroyed or player.Parent~=Players then return end
	result.engine="RobloxWorkspace"
	if result.error then warn("[SEDWARE Weapon] "..tostring(result.error)) end
	if result.sessionId and result.shotId then
		print("[SEDWARE Weapon][RESULT] "..HttpService:JSONEncode({shotId=result.shotId,weaponId=result.weaponId,
			mode=result.mode,pending=result.pending==true,accepted=result.accepted,hit=result.hit,
			selectedTargetHit=result.selectedTargetHit,damageApplied=result.damageApplied,
			pelletCount=result.pelletCount,pelletHits=result.pelletHits,reason=result.reason,
			physicsKind=result.physicsKind,referenceTime=result.referenceTime,engine=result.engine}))
		Result:FireClient(player,result)
	end
end
local random=Random.new()
local controller = ServerController.new({
	profiles=profiles,
	settings={MaxProjectiles=settings.MaxProjectiles,MaxProjectilesPerPlayer=settings.MaxProjectilesPerPlayer},
	random=function() return random:NextNumber() end,
	makeVector=Vector3.new,
	onResult=deliver,
	clock = function() return Workspace:GetServerTimeNow() end,
	isVector = vector,
	getEquippedWeapon = function(player)
		local character, tool,profileId = player.Character,nil,nil
		for id,candidate in playerTools[player] or {} do
			if candidate.Parent==character then tool=candidate;profileId=id;break end
		end
		if not character or not character:IsDescendantOf(Workspace) or not tool or tool.Parent ~= character
			or tool.Name ~= profiles[profileId].Name or tool:GetAttribute("OwnedSEDWAREWeapon") ~= true
			or tool:GetAttribute("SEDWAREProfileId")~=profileId then return nil end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
		local part = tool:FindFirstChild("Handle")
		local attachment = part and part:FindFirstChild("Muzzle")
		if not humanoid or humanoid.Health &lt;= 0 or not head or not head:IsA("BasePart")
			or not part or not part:IsA("BasePart") or not attachment or not attachment:IsA("Attachment") then return nil end
		local from = attachment.WorldPosition
		if not vector(from) or (from - head.Position).Magnitude &gt; 8 then return nil end
		return { tool = tool, profileId=profileId, character = character, humanoid = humanoid, origin = from }
	end,
	getTarget = function(userId, partName, expectedCharacter)
		local player = Players:GetPlayerByUserId(userId)
		local character = player and player.Character
		if not character or character ~= expectedCharacter or not character:IsDescendantOf(Workspace) then return nil end
		local humanoid, part = character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild(partName)
		if not humanoid or humanoid.Health &lt;= 0 or not part or not part:IsA("BasePart") then return nil end
		return { player = player, character = character, humanoid = humanoid, part = part, position = part.Position }
	end,
	raycast = function(from, direction, ignoreCharacter)
		local result=query(from,direction,ignoreCharacter)
		trace(from,if result then result.Position else from+direction)
		return result
	end,
	launchProjectile=function(from,velocity,profile,ignoreCharacter,complete)
		local part=Instance.new("Part")
		local tracker
		local ok,problem=xpcall(function()
			part.Name="PhysicalProjectile";part.Shape=Enum.PartType.Ball;part.Size=Vector3.new(0.25,0.25,0.25)
			part.Color=Color3.fromRGB(255,105,180);part.Material=Enum.Material.Neon
			part.Anchored=false;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
			part.Position=from;part.Parent=physicsFolder
			part:SetNetworkOwner(nil)
			local attachment=Instance.new("Attachment");attachment.Parent=part
			local force=Instance.new("VectorForce")
			force.Attachment0=attachment;force.RelativeTo=Enum.ActuatorRelativeTo.World;force.ApplyAtCenterOfMass=true
			force.Force=Vector3.new(0,(Workspace.Gravity-profile.Gravity)*part.AssemblyMass,0);force.Parent=part
			part.AssemblyLinearVelocity=velocity
			tracker=ProjectileTracker.new({origin=from,range=profile.Range,lifetime=profile.Lifetime,
				clock=function() return Workspace:GetServerTimeNow() end,
				getPosition=function()
					if not part.Parent then return nil end
					force.Force=Vector3.new(0,(Workspace.Gravity-profile.Gravity)*part.AssemblyMass,0)
					return part.Position
				end,
				raycast=function(origin,direction) return query(origin,direction,ignoreCharacter) end,
				onComplete=complete,
				dispose=function() if tracker then trackers[tracker]=nil end;part:Destroy() end})
			trackers[tracker]=true
		end,debug.traceback)
		if not ok then part:Destroy();error(problem) end
		return function() tracker:cancel() end
	end,
	describeHit = function(result)
		local model, humanoid = result.Instance:FindFirstAncestorOfClass("Model"), nil
		while model do
			humanoid = model:FindFirstChildOfClass("Humanoid")
			if humanoid then break end
			model = model:FindFirstAncestorOfClass("Model")
		end
		local targetPlayer = model and Players:GetPlayerFromCharacter(model)
		return { name = result.Instance:GetFullName(), position = result.Position,
			character = model, humanoid = humanoid, playerUserId = targetPlayer and targetPlayer.UserId }
	end,
	applyDamage = function(humanoid, amount)
		local before = humanoid.Health
		humanoid:TakeDamage(amount)
		return { before = before, after = humanoid.Health }
	end,
})

local function restoreRun(player)
	local run=verificationRuns[player]
	if not run then return end
	verificationRuns[player]=nil
	local restored,problem=pcall(function() run.humanoid.MaxHealth=run.maxHealth;run.humanoid.Health=run.health end)
	if not restored then warn("[SEDWARE Native] health restore failed: "..tostring(problem)) end
end
local function clearPlayer(player)
	for owner,run in verificationRuns do if owner==player or run.target==player then restoreRun(owner) end end
	local binding = playerConnections[player]
	if binding then binding:Disconnect(); playerConnections[player] = nil end
	for _,tool in playerTools[player] or {} do tool:Destroy() end
	playerTools[player]=nil
	controller:removePlayer(player)
end
local function grant(player, character)
	if destroyed or player.Parent ~= Players or player.Character ~= character then return end
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if destroyed or player.Parent ~= Players or player.Character ~= character or not backpack then return end
	local prior = playerTools[player]
	if prior then for _,tool in prior do tool:Destroy() end end
	playerTools[player]={}
	-- Do not modify a foreign Tool using the same name.
	for id,template in templates do
		if backpack:FindFirstChild(template.Name) or character:FindFirstChild(template.Name) then
			warn("[SEDWARE Weapon] Tool name conflict: "..template.Name.." for "..player.Name)
		else
			local tool=template:Clone();playerTools[player][id]=tool;tool.Parent=backpack
		end
	end
end
local function attachPlayer(player)
	if playerConnections[player] then return end
	playerConnections[player] = player.CharacterAdded:Connect(function(character) grant(player, character) end)
	if player.Character then task.defer(grant, player, player.Character) end
end
local function cleanup()
	if destroyed then return end
	destroyed = true
	for _, binding in connections do binding:Disconnect() end
	table.clear(connections)
	for player in playerConnections do clearPlayer(player) end
	for player in playerTools do clearPlayer(player) end
	controller:destroy()
	for tracker in trackers do tracker:cancel() end
	for _,template in templates do template:Destroy() end
	for player in verificationRuns do restoreRun(player) end
	Verification.OnServerInvoke=nil
	physicsFolder:Destroy()
	folder:Destroy()
end
table.insert(connections, StopOwner.Event:Connect(cleanup))
table.insert(connections, Fire.OnServerEvent:Connect(function(player, request)
	if destroyed then return end
	-- Malformed packets without an attributable ID are discarded; valid packets
	-- always receive an explicit accepted/rejected result.
	deliver(player,controller:process(player,request))
end))
table.insert(connections,RunService.Heartbeat:Connect(function()
	local now=Workspace:GetServerTimeNow()
	for player,run in verificationRuns do
		if now&gt;=run.deadline or not run.humanoid.Parent then restoreRun(player) end
	end
	for tracker in trackers do
		local ok,problem=pcall(function() tracker:step(Workspace:GetServerTimeNow()) end)
		if not ok then warn("[SEDWARE Weapon] projectile tracker: "..tostring(problem));tracker:cancel();trackers[tracker]=nil end
	end
end))
-- Optional F6 native verification uses these OWN Studio-only controls. Raising
-- health is test setup; every damage delta is still measured after TakeDamage.
Verification.OnServerInvoke=function(player,action,targetId,runId)
	if destroyed or player.Parent~=Players then return {ok=false,reason="server-unavailable"} end
	if action=="End" then
		local run=verificationRuns[player]
		if not run or run.id~=runId then return {ok=false,reason="unknown-native-run"} end
		restoreRun(player)
		return {ok=true}
	end
	if action~="Begin" then return {ok=false,reason="invalid-native-test-action"} end
	for _ in verificationRuns do return {ok=false,reason="native-run-already-active"} end
	local target=if finite(targetId) and targetId%1==0 then Players:GetPlayerByUserId(targetId) else nil
	local character=target and target.Character
	local humanoid=character and character:FindFirstChildOfClass("Humanoid")
	local root=character and character:FindFirstChild("HumanoidRootPart")
	local ownRoot=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not target or target==player or not humanoid or humanoid.Health&lt;=0 or not root or not ownRoot
		or (root.Position-ownRoot.Position).Magnitude&gt;40 then return {ok=false,reason="native-test-requires-two-live-players-within-40-studs"} end
	local run={id=HttpService:GenerateGUID(false),humanoid=humanoid,target=target,maxHealth=humanoid.MaxHealth,
		health=humanoid.Health,deadline=Workspace:GetServerTimeNow()+90}
	verificationRuns[player]=run
	humanoid.MaxHealth=10000;humanoid.Health=10000
	print("[SEDWARE Native] Started "..run.id.."; target health temporarily 10000, restored after test. Hits remain native collision results.")
	return {ok=true,runId=run.id,engine="RobloxWorkspace"}
end
table.insert(connections, Players.PlayerAdded:Connect(attachPlayer))
table.insert(connections, Players.PlayerRemoving:Connect(clearPlayer))
table.insert(connections, script.Destroying:Connect(cleanup))
folder.Parent = ReplicatedStorage
for _, player in Players:GetPlayers() do attachPlayer(player) end
print("[SEDWARE Weapon] OWN Studio controllers ready: six Tool templates, server spread and physical projectile launcher. Each shot still requires equipped-Tool validation and an actual collision result.")
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="Players" referent="RBX21">
    <Properties>
      <string name="Name">Players</string>
    </Properties>
  </Item>
  <Item class="Lighting" referent="RBX22">
    <Properties>
      <string name="Name">Lighting</string>
    </Properties>
  </Item>
</roblox>