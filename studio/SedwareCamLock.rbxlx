  if self.config.DebugMode and (not self.nextAcquisitionDebug or now&gt;=self.nextAcquisitionDebug) then
   self.nextAcquisitionDebug=now+1;Runtime.trace(self.report,"Acquisition","SEARCHING",reason)
  end
