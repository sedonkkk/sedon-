 if type(points)~="table" or getmetatable(points)~=nil then return false,"PingReferences inválido" end
 local count=0
 for key in points do
  if type(key)~="number" or key%1~=0 or key&lt;1 or key&gt;32 then return false,"Índice de PingReferences inválido" end
  count+=1
 end
